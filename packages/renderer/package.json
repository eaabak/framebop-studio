{
  "name": "@framebop/renderer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Turns an episode's scenes into a deterministic render plan, and renders it to MP4 with Remotion in a separate process.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scene": "./src/animation/AnimatedScene.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "ensure-browser": "node scripts/ensure-browser.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@framebop/core": "workspace:*",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.535",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
